# Data: never commit raw or licensed data
data/
*.parquet
*.feather
*.h5
*.itch
*.pcap
*.gz
*.zst

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.ipynb_checkpoints/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
dist/

# C++ / Rust / CUDA builds
build/
cmake-build-*/
target/
*.o
*.obj
*.so
*.dll
*.pyd
*.exe

# Editors, OS, secrets
.vscode/
.idea/
.DS_Store
Thumbs.db
.env

# Local build spec (kept out of the public repo)
SPEC.html

# data/ may be a symlink into DATA_ROOT, which the data/ rule above does not match
/data

# Test and tool caches
.coverage
.coverage.*
coverage.xml
htmlcov/
.hypothesis/
.benchmarks/
