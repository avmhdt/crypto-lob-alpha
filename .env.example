# crypto-lob-alpha environment. Copy to .env (git-ignored). Never commit .env.
# ---------- required ----------
DATA_ROOT=~/data/crypto-lob-alpha      # required: data root inside the WSL ext4 filesystem, never /mnt/* (~ expanded by the settings loader; repo data/ is a symlink to it)
LOB_DATA_DIR=                          # optional: root of the Parquet lake; empty = DATA_ROOT
LOB_VENUE_SET=binance-usdm,coinbase,kraken   # required: comma-separated venue ids (D-01, resolved 2026-10-31); add bybit-linear only after P-16
# ---------- optional ----------
LOB_LOG_LEVEL=INFO                     # optional: DEBUG | INFO | WARNING
LOB_LOG_DIR=/home/USER/lob-logs        # optional: JSON log directory for the recorder service
LOB_RAW_ARCHIVE_DAYS=7                 # optional: rolling retention of the raw websocket archive (D-06)
LOB_MIN_FREE_GB=20                     # optional: recorder drops the raw archive, then alerts, below this free space
LOB_ALERT_WEBHOOK_URL=                 # optional: ntfy/Discord webhook for stream-down alerts (D-14)
COINBASE_API_KEY=                      # optional: view-only Coinbase Exchange key, only for the full/L3 channel (D-07)
COINBASE_API_SECRET=                   # optional: secret for the key above
COINBASE_API_PASSPHRASE=               # optional: passphrase for the key above
TARDIS_API_KEY=                        # optional, PAID: only if D-04 is approved; free first-of-month samples need no key
